generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / users
// ─────────────────────────────────────────────────────────────────────────

model Role {
  id        String   @id @default(uuid())
  name      String   @unique // ADMIN | STUDENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  roleId       String   @map("role_id")
  classId      String?  @map("class_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])
  // The grade a student is studying - admins have none, and students created
  // before grade selection existed start null (they get gated in the UI until
  // they pick one). SetNull so deleting a class never deletes its students.
  class Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdClasses      Class[]               @relation("ClassCreatedBy")
  createdSubjects     Subject[]             @relation("SubjectCreatedBy")
  createdChapters     Chapter[]             @relation("ChapterCreatedBy")
  createdQuestions    Question[]            @relation("QuestionCreatedBy")

  @@index([roleId])
  @@index([classId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Content hierarchy: Class -> Subject -> Chapter -> Question
// ─────────────────────────────────────────────────────────────────────────

model Class {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  order       Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User      @relation("ClassCreatedBy", fields: [createdById], references: [id])
  subjects  Subject[]
  students  User[]

  @@index([createdById])
  @@map("classes")
}

model Subject {
  id          String   @id @default(uuid())
  classId     String   @map("class_id")
  title       String
  slug        String
  order       Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SubjectCreatedBy", fields: [createdById], references: [id])
  chapters  Chapter[]

  @@unique([classId, slug])
  @@index([createdById])
  @@map("subjects")
}

model Chapter {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  title       String
  slug        String
  order       Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy User       @relation("ChapterCreatedBy", fields: [createdById], references: [id])
  questions Question[]

  @@unique([subjectId, slug])
  @@index([createdById])
  @@map("chapters")
}

// ─────────────────────────────────────────────────────────────────────────
// Questions - full CRUD, CSV bulk import, and the Notes view over
// SHORT_ANSWER / LONG_ANSWER questions.
// ─────────────────────────────────────────────────────────────────────────

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
  LONG_ANSWER
}

model Question {
  id                String       @id @default(uuid())
  chapterId         String       @map("chapter_id")
  type              QuestionType
  text              String       @db.Text
  explanation       String?      @db.Text
  isPublished       Boolean      @default(false) @map("is_published")
  createdById       String       @map("created_by_id")
  correctAnswerText String?      @map("correct_answer_text")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  chapter   Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdBy User             @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  options   QuestionOption[]

  @@index([chapterId])
  @@index([createdById])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}
