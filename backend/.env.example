# Postgres connection string used by Prisma
DATABASE_URL="postgresql://app_user:app_password_dev123@localhost:5432/computer_dev?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed by CORS + used to build reset-password links
FRONTEND_URL="http://localhost:5173"

# JWT secrets - replace with strong random values in every real deployment
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password reset token lifetime (minutes)
PASSWORD_RESET_TOKEN_TTL_MIN=30
